 build() {
   local _cmake_args=(
-    -DCMAKE_BUILD_TYPE='None'
-    -DCMAKE_INSTALL_PREFIX='/usr'
+    -Wno-dev
+    -G Ninja
+    -DCMAKE_BUILD_TYPE=None
+    -DCMAKE_INSTALL_PREFIX=/usr
     -DCMAKE_SKIP_RPATH=TRUE
     -DCMAKE_VERBOSE_MAKEFILE=ON
+    -DONNX_ML=ON
     -DONNX_USE_PROTOBUF_SHARED_LIBS=ON
-    -DBUILD_SHARED_LIBS=ON
-    -Wno-dev
   )
   cd $pkgbase
-  CMAKE_ARGS="${_cmake_args[@]}" python -m build --wheel --no-isolation
+
+  cmake -B build "${_cmake_args[@]}" \
+    -DBUILD_SHARED_LIBS=ON \
+    -DONNX_BUILD_PYTHON=OFF \
+    -DONNX_INSTALL=ON
+  cmake --build build
+
+  CMAKE_ARGS="${_cmake_args[*]}" python -m build --wheel --no-isolation
 }
 
 package_onnx() {
 depends=(
-  gcc-libs
+  libgcc
+  libstdc++
   glibc
   abseil-cpp
   protobuf
 )
-  DESTDIR="$pkgdir" cmake --install $pkgbase/.setuptools-cmake-build
+  DESTDIR="$pkgdir" cmake --install $pkgbase/build
+  find "$pkgdir/usr/include" -type d -empty -delete
   install -Dm644 $pkgbase/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
 }
 
 package_python-onnx() {
 depends=(
-  onnx
   python
   glibc
-  gcc-libs
+  libgcc
+  libstdc++
   protobuf
   python-protobuf
   python-ml-dtypes
   python-numpy
+  python-typing_extensions
 )
   cd $pkgbase
   python -m installer --destdir="${pkgdir}" dist/*.whl



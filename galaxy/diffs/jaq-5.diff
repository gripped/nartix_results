--- Arch PKGBUILD
+++ Artix PKGBUILD
@@ -1,37 +1,43 @@
 
 pkgname=jaq
-pkgver=3.1.0
-pkgrel=3
+pkgver=3.1.1
+pkgrel=1
 pkgdesc='A jq clone focussed on correctness, speed, and simplicity'
 url="https://github.com/01mf02/$pkgname"
 arch=(x86_64)
 license=(MIT)
-depends=(gcc-libs
-         glibc)
+depends=(glibc # libc.so libm.so
+         libgcc libgcc_s.so)
 makedepends=(cargo
-             pandoc)
+             jotdown)
 _archive="$pkgname-$pkgver"
-source=("$url/archive/v$pkgver/$_archive.tar.gz")
-sha256sums=('8ad074d7e90e07ad7e77048dcf0d0e7ad434b8e3e38044260b9457d4551e644d')
+source=("$url/archive/refs/tags/v$pkgver/$_archive.tar.gz")
+sha256sums=('9b8587436be48b5791c8276573321a3d4f404e0dc77ea6503d05725a55edd266')
+
+_srcenv() {
+	cd "$_archive"
+	export CARGO_HOME="$srcdir"
+	export CARGO_PROFILE_RELEASE_DEBUG=2
+	export CARGO_PROFILE_RELEASE_STRIP=false
+	export CARGO_PROFILE_RELEASE_LTO=true
+	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
+	export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
+	CFLAGS+=' -ffat-lto-objects'
+}
 
 prepare() {
-	cd "$_archive"
+	_srcenv
 	cargo fetch --locked --target host-tuple
 }
 
 build() {
-	cd "$_archive"
-	CFLAGS+=' -ffat-lto-objects'
-	export CARGO_PROFILE_RELEASE_LTO=true
-	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
-	export CARGO_PROFILE_RELEASE_DEBUG=2
-	export CARGO_PROFILE_RELEASE_STRIP=false
+	_srcenv
 	cargo build --frozen --release
 	make -C docs "$pkgname.1"
 }
 
 check() {
-	cd "$_archive"
+	_srcenv
 	cargo test --frozen
 }
 


